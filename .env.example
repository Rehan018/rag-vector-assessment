# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# Retrieval Configuration
TOP_K=3

# Ollama Configuration (for query expansion)
OLLAMA_BASE_URL=https://ollama.merai.app
OLLAMA_MODEL_NAME=llama4:latest

# Data Paths
CORPUS_PATH=data/technical_corpus.json
BENCHMARK_OUTPUT_PATH=retrieval_benchmark.md
